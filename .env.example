# Set this to the ProForms submission endpoint for your account.
# The contact form falls back to https://proforms.top when unset.
NEXT_PUBLIC_PROFORMS_ENDPOINT=https://proforms.top

# Resend mail composer settings. RESEND_FROM_EMAIL must use a verified domain.
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_NAME=X-BUC TECH
MAIL_ACCESS_KEY=replace-with-a-long-private-key

# Optional: preset "From" addresses shown in the composer (Label:email, comma separated).
MAIL_SENDERS=Hello:hello@xbuctech,Support:support@xbuctech,Info:info@xbuctech
# Signing secret from Resend → Webhooks (endpoint: https://<your-domain>/api/mail/webhook).
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxx
# Optional: forward inbound (email.received) mail to these addresses, comma separated.
MAIL_FORWARD_TO=
